/* "Connect my National Bank account (demo)" and the portfolio dashboard */
.demo {
  margin-top: 30px;
  display: grid;
  gap: 20px;
}

.demo-connect,
.demo-card {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  padding: 26px;
}

.demo-bank {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}

.demo-bank h2 {
  margin: 0 0 6px;
  font-size: 22px;
}

.demo-bank p {
  margin: 0;
  color: #6b6b6b;
}

.demo-bank-logo {
  flex: none;
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: #cf1726;
  color: #ffffff;
  font-weight: 800;
  display: grid;
  place-items: center;
  letter-spacing: 0.5px;
}

.demo-badge {
  margin-left: auto;
  padding: 4px 10px;
  border-radius: 999px;
  background: #fff3d1;
  color: #9a6a00;
  font-size: 12px;
  font-weight: 700;
}

.demo-pick {
  margin: 24px 0 12px;
  font-weight: 600;
  color: #333333;
}

.demo-clients {
  display: grid;
  grid-template-columns: repeat(3, minmax(0,
    1fr));
  gap: 14px;
}

.demo-client {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  padding: 18px;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  background: #fafafa;
  text-align: left;
  font: inherit;
  color: #252525;
  cursor: pointer;
  transition: border-color 0.15s, box-shadow 0.15s;
}

.demo-client:hover,
.demo-client:focus-visible {
  border-color: #cf1726;
  box-shadow: 0 4px 16px rgba(0,
    0,
    0,
    0.06);
  background: #ffffff;
}

.demo-client > span {
  color: #6b6b6b;
  font-size: 14px;
}

.demo-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #dce9fa;
  color: #1d5fae !important;
  font-weight: 800;
  display: grid;
  place-items: center;
  margin-bottom: 6px;
  font-size: 17px !important;
}

.demo-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 6px 0;
}

.demo-chips em {
  font-style: normal;
  font-size: 12px;
  padding: 3px 8px;
  border-radius: 999px;
  background: #ececec;
  color: #333333;
}

.demo-goal {
  min-height: 40px;
}

.demo-login {
  margin-top: 8px;
  color: #cf1726 !important;
  font-weight: 700;
}

.demo-loading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 26px;
  padding: 18px;
  border-radius: 10px;
  background: #fafafa;
  font-weight: 600;
}

.demo-spinner {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 3px solid #f0c9cc;
  border-top-color: #cf1726;
  animation: demo-spin 0.8s linear infinite;
}

@keyframes demo-spin {
  to {
    transform: rotate(360deg);
    }
}

.demo-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
}

.demo-head h2 {
  margin: 4px 0 6px;
  font-size: 26px;
}

.demo-sub {
  margin: 0;
  color: #6b6b6b;
}

.demo-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,
    1fr));
  gap: 14px;
}

.demo-stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 18px;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
}

.demo-stat span {
  font-size: 13px;
  color: #6b6b6b;
}

.demo-stat strong {
  font-size: 26px;
  color: #252525;
}

.demo-stat em {
  font-style: normal;
  font-size: 12px;
  color: #9a9a9a;
}

.demo .up {
  color: #0f7a52;
}

.demo .down {
  color: #cf1726;
}

.demo .chart {
  max-width: none;
}

.demo-grid {
  display: grid;
  grid-template-columns: minmax(0,
    1.1fr) minmax(0,
    1fr);
  gap: 20px;
}

.demo-card h3 {
  margin: 0 0 12px;
  font-size: 17px;
}

.demo-card h3 + svg,
.demo-card svg + h3 {
  margin-top: 4px;
}

.demo-card .chart-svg {
  display: block;
  width: 100%;
  height: auto;
}

.demo-facts {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}

.demo-facts li {
  padding: 12px 14px;
  border-radius: 10px;
  background: #f6f6f6;
  font-size: 14px;
  line-height: 1.5;
  color: #333333;
  border-left: 4px solid #c4c4c4;
}

.demo-facts li.watch {
  background: #fdf1ec;
  border-left-color: #eb6834;
}

.demo-facts li.good {
  background: #eaf7f1;
  border-left-color: #1baf7a;
}

.demo-level {
  display: block;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: #6b6b6b;
  margin-bottom: 2px;
}

.demo-ask {
  margin-top: 18px;
  width: 100%;
}

.demo-table-wrap {
  overflow-x: auto;
}

.demo-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.demo-table th {
  text-align: left;
  font-size: 12px;
  color: #6b6b6b;
  font-weight: 600;
  padding: 8px 10px;
  border-bottom: 1px solid #e5e5e5;
  white-space: nowrap;
}

.demo-table td {
  padding: 12px 10px;
  border-bottom: 1px solid #f0f0f0;
  vertical-align: middle;
  white-space: nowrap;
}

.demo-table td strong {
  display: block;
}

.demo-table td span {
  font-size: 12px;
  color: #9a9a9a;
}

.demo-weight {
  display: inline-block;
  width: 60px;
  height: 6px;
  margin-right: 8px;
  border-radius: 3px;
  background: #ececec;
  vertical-align: middle;
  overflow: hidden;
}

.demo-weight i {
  display: block;
  height: 100%;
  background: #2a78d6;
}

.demo-toggle {
  background: none;
  border: 0;
  padding: 0;
  font: inherit;
  font-weight: 700;
  color: #cf1726;
  cursor: pointer;
}

.demo-context {
  margin: 14px 0 0;
  padding: 16px;
  border-radius: 10px;
  background: #f6f6f6;
  font-size: 12.5px;
  line-height: 1.6;
  white-space: pre-wrap;
  color: #333333;
}

@media (max-width: 800px) {
  .demo-clients,
  .demo-grid {
    grid-template-columns: 1fr;
    }
  .demo-stats {
    grid-template-columns: repeat(2, minmax(0,
        1fr));
    }
  .demo-head {
    flex-direction: column;
    }
  .demo-connect,
  .demo-card {
    padding: 18px;
    }
  .demo-badge {
    display: none;
    }
}

.demo .chart-svg {
  display: block;
  width: 100%;
  height: auto;
}

.demo-bars {
  list-style: none;
  margin: 0 0 22px;
  padding: 0;
  display: grid;
  gap: 10px;
}

.demo-bars li {
  display: grid;
  grid-template-columns: 130px 1fr 52px;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: #333333;
}

.demo-bars strong {
  text-align: right;
}

.demo-bar {
  height: 12px;
  border-radius: 6px;
  background: #f0f0f0;
  overflow: hidden;
}

.demo-bar i {
  display: block;
  height: 100%;
  border-radius: 6px;
}

.demo {
  grid-template-columns: minmax(0,
    1fr);
}

.demo > * {
  min-width: 0;
}

.demo .chart {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
}

.demo .chart .chart-svg {
  max-width: 820px;
  margin: 0 auto;
}

.demo-chips em.level-novice {
  background: #d9f3e8;
  color: #0f7a52;
}

.demo-chips em.level-intermediate {
  background: #fff3d1;
  color: #9a6a00;
}

.demo-chips em.level-expert {
  background: #e6e2fa;
  color: #4a3bb0;
}

.demo-background {
  margin-top: 4px;
  font-size: 14px;
  color: #9a9a9a;
}
/* interactive account graph (PortfolioChart.tsx) */
.pchart {
  background: #ffffff;
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  padding: 22px 22px 16px;
}

.pchart-head {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.pchart-label {
  font-size: 13px;
  color: #6b6b6b;
}

.pchart-value {
  font-size: 32px;
  color: #252525;
  font-variant-numeric: tabular-nums;
}

.pchart-change {
  font-size: 14px;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.pchart-change em {
  font-style: normal;
  font-weight: 400;
  color: #6b6b6b;
  margin-left: 6px;
}

.pchart-legend {
  display: flex;
  gap: 16px;
  margin: 14px 0 4px;
  font-size: 12px;
  color: #6b6b6b;
}

.pchart-legend i,
.pchart-tip i {
  display: inline-block;
  width: 14px;
  height: 3px;
  border-radius: 2px;
  vertical-align: middle;
  margin-right: 4px;
}

.pchart-legend i.dashed,
.pchart-tip i.dashed {
  background: repeating-linear-gradient(90deg, #9a9a9a 0 5px, transparent 5px 8px);
}

.pchart-plot {
  position: relative;
  width: 100%;
  cursor: crosshair;
  touch-action: pan-y;
  outline: none;
  border-radius: 8px;
}

.pchart-plot:focus-visible {
  box-shadow: 0 0 0 2px #cf1726;
}

.pchart-svg {
  display: block;
}

.pchart-axis {
  font-size: 11px;
  fill: #9a9a9a;
}

.pchart-tip {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 190px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #ffffff;
  border: 1px solid #e5e5e5;
  box-shadow: 0 6px 20px rgba(0,
    0,
    0,
    0.1);
  font-size: 12.5px;
  color: #333333;
  pointer-events: none;
  white-space: nowrap;
}

.pchart-tip strong {
  font-size: 12px;
  color: #6b6b6b;
  font-weight: 600;
}

.pchart-tip span {
  display: flex;
  align-items: center;
  gap: 2px;
}

.pchart-tip b {
  margin-left: auto;
  padding-left: 12px;
  color: #252525;
  font-variant-numeric: tabular-nums;
}

.pchart-tip span.up b {
  color: #0f7a52;
}

.pchart-tip span.down b {
  color: #cf1726;
}

.pchart-ranges {
  display: flex;
  justify-content: center;
  gap: 6px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.pchart-ranges button {
  min-width: 44px;
  padding: 7px 12px;
  border: none;
  border-radius: 999px;
  background: transparent;
  color: #6b6b6b;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}

.pchart-ranges button:hover {
  background: #f5efe6;
  color: #252525;
}

.pchart-ranges button.active {
  background: #252525;
  color: #ffffff;
}

.pchart-note {
  margin: 8px 0 0;
  text-align: center;
  font-size: 12px;
  color: #9a9a9a;
}

@media (max-width: 800px) {
  .pchart {
    padding: 16px 12px 12px;
    }
  .pchart-value {
    font-size: 26px;
    }
  .pchart-ranges button {
    min-width: 0;
    padding: 7px 9px;
    }
}
/* "Ideas for your next $1,000" wheel (NextIdeas.tsx) */
.ideas-head {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.ideas-head h3 {
  margin: 0;
}

.ideas-badge {
  padding: 3px 9px;
  border-radius: 999px;
  background: #fcf3f4;
  color: #cf1726;
  font-size: 11px;
  font-weight: 700;
}

.ideas-sub {
  margin: 6px 0 14px;
  font-size: 14px;
  color: #6b6b6b;
}

.ideas-body {
  display: grid;
  grid-template-columns: minmax(0,
    300px) minmax(0,
    1fr);
  gap: 28px;
  align-items: center;
}

.ideas-wheel {
  display: block;
  width: 100%;
  max-width: 300px;
  height: auto;
  margin: 0 auto;
  overflow: visible;
}

.ideas-slice {
  cursor: pointer;
  outline: none;
}

.ideas-slice path {
  transition: opacity 0.15s;
}

.ideas-slice:focus-visible path {
  stroke: #252525;
  stroke-width: 3;
}

.ideas-pct {
  font-size: 13px;
  font-weight: 800;
  pointer-events: none;
}

.ideas-center-amount {
  font-size: 22px;
  font-weight: 800;
  fill: #252525;
}

.ideas-center-label {
  font-size: 12px;
  fill: #6b6b6b;
}

.ideas-detail {
  display: flex;
  flex-direction: column;
  gap: 6px;
  min-width: 0;
}

.ideas-type {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #6b6b6b;
}

.ideas-type i {
  width: 12px;
  height: 12px;
  border-radius: 4px;
  flex: none;
}

.ideas-name {
  font-size: 20px;
  color: #252525;
  line-height: 1.3;
}

.ideas-meta {
  font-size: 13px;
  color: #9a9a9a;
}

.ideas-why {
  margin: 8px 0 0;
  padding: 12px 14px;
  border-radius: 10px;
  border-left: 4px solid #2a78d6;
  background: #f5efe6;
  font-size: 14.5px;
  line-height: 1.55;
  color: #252525;
  transition: border-color 0.15s;
}

.ideas-why b {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: #6b6b6b;
  margin-bottom: 3px;
}

.ideas-tip {
  margin: 8px 0 0;
  padding: 10px 12px;
  border-radius: 10px;
  border-left: 4px solid #eb6834;
  background: #f5efe6;
  font-size: 13px;
  line-height: 1.5;
  color: #333333;
}

.ideas-tip b {
  display: block;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: #6b6b6b;
  margin-bottom: 2px;
}

@media (max-width: 800px) {
  .ideas-body {
    grid-template-columns: minmax(0,
        1fr);
    gap: 16px;
    }
  .ideas-wheel {
    max-width: 240px;
    }
}
/* right column: what you own + ideas wheel stacked; the wheel sits above its details there */
.demo-side {
  display: flex;
  flex-direction: column;
  gap: 20px;
  min-width: 0;
}
/* both columns end at the same height: the ideas card fills what is left on the right */
.demo-grid {
  align-items: stretch;
}

.demo-side .ideas {
  flex: 1;
  padding: 20px 22px;
}

.demo-side .ideas-sub {
  margin: 4px 0 10px;
  font-size: 13px;
}

.demo-side .ideas-body {
  grid-template-columns: minmax(0,
    1fr);
  gap: 10px;
}

.demo-side .ideas-wheel {
  max-width: 170px;
}
/* the small wheel is scaled down, so its text is drawn larger to stay readable */
.demo-side .ideas-pct {
  font-size: 18px;
}

.demo-side .ideas-center-amount {
  font-size: 30px;
}

.demo-side .ideas-center-label {
  font-size: 16px;
}

.demo-side .ideas-name {
  font-size: 16px;
}

.demo-side .ideas-why {
  font-size: 13.5px;
  padding: 10px 12px;
}

.demo-side .ideas .disclaimer {
  margin: 10px 0 0;
  font-size: 11.5px;
}